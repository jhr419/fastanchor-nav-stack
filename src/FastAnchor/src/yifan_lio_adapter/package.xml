<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yifan_lio_adapter</name>
  <version>0.1.0</version>
  <description>
    Lightweight interface adapter that converts yifanLIO output (world->IMU odometry
    and lidar-frame undistorted cloud) into the FAST-LIO-compatible FastAnchor LIO
    interface (/Odometry camera_init->body + /cloud_registered_body in body frame).
  </description>
  <maintainer email="fastanchor@example.com">FastAnchor</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>yaml-cpp</depend>
  <depend>ament_index_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
