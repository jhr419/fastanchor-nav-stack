#!/usr/bin/env python3

"""Start/stop go2_twist_bridge through a ROS2 SetBool service."""

import os
import signal
import subprocess
import threading
import time

import rclpy
from rclpy.node import Node
from std_srvs.srv import SetBool


class Go2TwistBridgeServiceManager(Node):

    def __init__(self):
        super().__init__("go2_twist_bridge_service_manager")

        self.declare_parameter(
            "service_name",
            "/go2_twist_bridge/set_enabled",
        )
        self.declare_parameter(
            "package_name",
            "go2_twist_bridge",
        )
        self.declare_parameter(
            "launch_file",
            "twist_bridge.launch.py",
        )

        self._service_name = str(
            self.get_parameter("service_name").value
        )
        self._package_name = str(
            self.get_parameter("package_name").value
        )
        self._launch_file = str(
            self.get_parameter("launch_file").value
        )

        self._lock = threading.RLock()
        self._process = None

        self._service = self.create_service(
            SetBool,
            self._service_name,
            self._service_callback,
        )

        self.get_logger().info(
            "Go2 twist bridge service manager ready"
        )
        self.get_logger().info(
            "Service: %s" % self._service_name
        )
        self.get_logger().info(
            "Start command: ros2 launch %s %s"
            % (
                self._package_name,
                self._launch_file,
            )
        )

    # =========================================================
    # State
    # =========================================================

    def _is_running_locked(self):
        if self._process is None:
            return False

        if self._process.poll() is not None:
            self._process = None
            return False

        return True

    # =========================================================
    # Start
    # =========================================================

    def _start_bridge(self):

        with self._lock:

            if self._is_running_locked():
                return (
                    True,
                    "go2_twist_bridge is already running",
                )

            command = [
                "ros2",
                "launch",
                self._package_name,
                self._launch_file,
            ]

            self.get_logger().info(
                "Starting: %s"
                % " ".join(command)
            )

            try:
                self._process = subprocess.Popen(
                    command,
                    env=os.environ.copy(),
                    start_new_session=True,
                )

            except Exception as error:
                self._process = None

                return (
                    False,
                    "Failed to start go2_twist_bridge: %s"
                    % str(error),
                )

            # Detect immediate launch failure.
            time.sleep(0.5)

            if self._process.poll() is not None:
                return_code = self._process.returncode
                self._process = None

                return (
                    False,
                    "go2_twist_bridge exited immediately "
                    "with code %s"
                    % return_code,
                )

            pid = self._process.pid

            self.get_logger().info(
                "go2_twist_bridge started, PID=%d"
                % pid
            )

            return (
                True,
                "go2_twist_bridge started",
            )

    # =========================================================
    # Stop
    # =========================================================

    def _stop_bridge(self):

        with self._lock:

            if not self._is_running_locked():
                return (
                    True,
                    "go2_twist_bridge is already stopped",
                )

            process = self._process
            pid = process.pid

            self.get_logger().info(
                "Stopping go2_twist_bridge, PID=%d"
                % pid
            )

            try:
                # ros2 launch creates children, therefore signal
                # the entire process group rather than only the
                # ros2 command itself.
                os.killpg(
                    os.getpgid(pid),
                    signal.SIGINT,
                )

                try:
                    process.wait(timeout=5.0)

                except subprocess.TimeoutExpired:

                    self.get_logger().warning(
                        "SIGINT timeout; sending SIGTERM"
                    )

                    os.killpg(
                        os.getpgid(pid),
                        signal.SIGTERM,
                    )

                    try:
                        process.wait(timeout=2.0)

                    except subprocess.TimeoutExpired:

                        self.get_logger().warning(
                            "SIGTERM timeout; sending SIGKILL"
                        )

                        os.killpg(
                            os.getpgid(pid),
                            signal.SIGKILL,
                        )

                        process.wait(timeout=2.0)

            except ProcessLookupError:
                pass

            except Exception as error:

                self.get_logger().error(
                    "Error while stopping bridge: %s"
                    % str(error)
                )

                self._process = None

                return (
                    False,
                    "Failed to stop go2_twist_bridge: %s"
                    % str(error),
                )

            self._process = None

            self.get_logger().info(
                "go2_twist_bridge stopped"
            )

            return (
                True,
                "go2_twist_bridge stopped",
            )

    # =========================================================
    # ROS Service
    # =========================================================

    def _service_callback(
        self,
        request,
        response,
    ):

        if request.data:
            success, message = self._start_bridge()
        else:
            success, message = self._stop_bridge()

        response.success = success
        response.message = message

        return response

    # =========================================================
    # Shutdown
    # =========================================================

    def destroy_node(self):

        try:
            self._stop_bridge()
        except Exception:
            pass

        return super().destroy_node()


def main(args=None):

    rclpy.init(args=args)

    node = Go2TwistBridgeServiceManager()

    try:
        rclpy.spin(node)

    except KeyboardInterrupt:
        pass

    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
